###### 对于每盆中先加入以及后引入植物总体生物量的影响
pot_cwm_corr_data = read.xlsx("field experiment cover biomass survival 260409.xlsx", sheet = "pot_mass", rowNames = F, colNames = T)
colnames(pot_cwm_corr_data)
#pot_cwm_corr_data = pot_cwm_corr_data %>% left_join(pot_infor)

pot_cwm_corr_data$yr = as.factor(pot_cwm_corr_data$Time)
pot_cwm_corr_data$Origin2 = ifelse(pot_cwm_corr_data$Origin2 == "Exotic", "Alien", pot_cwm_corr_data$Origin2)
pot_cwm_corr_data$Origin2 = as.factor(pot_cwm_corr_data$Origin2)
pot_cwm_corr_data$SR2 = as.factor(pot_cwm_corr_data$SR2)
pot_cwm_corr_data$pot = as.factor(pot_cwm_corr_data$pot)
pot_cwm_corr_data$add_sp_list = as.factor(pot_cwm_corr_data$add_sp_list)
pot_cwm_corr_data$res_sp_list = as.factor(pot_cwm_corr_data$res_sp_list)

pot_cwm_corr_data = subset(pot_cwm_corr_data, Origin2 != "ck")

