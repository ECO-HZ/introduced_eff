# X2_F_hgt
mod_pot_X2_F_hgt = lmer(X2_F_hgt ~ yr * Origin2 * SR2 + 
                          (1|Origin2:SR2:pot) + 
                          (1|add_sp_list) + 
                          (1|res_sp_list), data = pot_cwm_corr_data)
#anova(mod_pot_X2_F_hgt, type = 3)
car::Anova(mod_pot_X2_F_hgt)
summary(mod_pot_X2_F_hgt)
ranova(mod_pot_X2_F_hgt)

time_xOx_SR_effect = emmeans(mod_pot_X2_F_hgt, specs = pairwise ~ yr*Origin2*SR2, type = "response")
emm1_multi = multcomp::cld(time_xOx_SR_effect, alpha=0.05, Letters=letters, adjust="none", decreasing = T)
emm1_multi$.group <- trimws(emm1_multi$.group)

emm1_multi <- emm1_multi %>%
  mutate(group_new = if_else(
    str_length(.group) >= 2,
    paste0(str_extract(.group, "^([a-zA-Z])"),
           "-",str_extract(.group, "([a-zA-Z])$")),.group))

#pot_X2_F_hgt_data1 = Rmisc::summarySE(pot_cwm_corr_data, groupvars = c("yr", "SR2", "Origin2"), measurevar = "X2_F_hgt", na.rm = T)
pot_X2_F_hgt_data1 = emm1_multi
pot_X2_F_hgt_data1$Group = paste0(pot_X2_F_hgt_data1$Origin2, "|", pot_X2_F_hgt_data1$SR2)
colnames(pot_X2_F_hgt_data1)[4] <- "X2_F_hgt"
#pot_X2_F_hgt_data1 = pot_X2_F_hgt_data1 %>% left_join(emm1_multi[,c("yr", "SR2", "Origin2", ".group", "group_new")])

ggplot(pot_X2_F_hgt_data1, aes(x = yr, y = X2_F_hgt, group = Group, color = Group, fill = Group, shape = Group)) + 
  geom_errorbar(aes(ymin = lower.CL, ymax =upper.CL, color = Group), 
                width = 0, position = position_dodge(width = 0.5), size = 0.8) + 
  geom_line(aes(color = Group), position = position_dodge(width = 0.5), size = 0.8) +
  geom_point(size = 3, position = position_dodge(width = 0.5)) + 
  geom_text(aes(y = ifelse(X2_F_hgt >= 0, upper.CL, upper.CL),  
                label = group_new, color = Origin), color = "black",
            vjust = ifelse(pot_X2_F_hgt_data1$X2_F_hgt >= 0, -0.5, -0.5), size = 3.875,
            position = position_dodge(width = 0.5)) +  # fontface = "bold"
  scale_x_discrete(breaks = unique(pot_X2_F_hgt_data1$yr),
                   #labels = c("Starting", "2021", "2022", "2023", "2024"),
                   labels = c("2022" = "5", "2023" = "17", "2024" = "29", "2025" = "40"),  
                   expand = expansion(mult = c(0.1, 0.1))) +
  #scale_y_continuous(limits = c(0, 8),
  #                   expand = expansion(mult = 0),
  #                   breaks = seq(0, 8, by = 2)) +
  theme_classic() +
  scale_color_manual(values = c("ck|0" = "#70319D", 
                                "Native|1" = "#3C8FB6", "Native|2" = "#3C8FB6", "Native|4" = "#3C8FB6", 
                                "Alien|1" = "#A9405F", "Alien|2" = "#A9405F", "Alien|4" = "#A9405F")) + 
  scale_fill_manual(values = c("ck|0" = "#70319D", 
                               "Native|1" = "#3C8FB6", "Native|2" = "#3C8FB6", "Native|4" = "#3C8FB6", 
                               "Alien|1" = "#A9405F", "Alien|2" = "#A9405F", "Alien|4" = "#A9405F")) + 
  scale_shape_manual(values = c("ck|0" = 21, 
                                "Native|1" = 22, "Native|2" = 23, "Native|4" = 24, 
                                "Alien|1" = 22, "Alien|2" = 23, "Alien|4" = 24)) + 
  theme(panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA),
        legend.background = element_rect(fill = "transparent", color = NA),
        legend.box.background = element_rect(fill = "transparent", color = NA),
        axis.ticks = element_line(color='black'),
        axis.line = element_line(colour = "black"), 
        axis.title = element_text(colour='black', size=13),
        axis.text.x = element_text(colour='black',size=11),
        axis.text.y = element_text(colour='black',size=11),
        plot.tag = element_text(size = 14, face = "bold"),
        strip.background = element_rect(color = "black", size = 0.5, fill = "white"),
        strip.text = element_text(colour='black', size=11), 
        #plot.margin = margin(1,1,1,2,unit="cm"),
        legend.position = "none") + 
  labs(x = "Sampling time (months)", 
       y = "CWM of plant height\nin the introduced community", 
       tag = "A") -> pp1; pp1


