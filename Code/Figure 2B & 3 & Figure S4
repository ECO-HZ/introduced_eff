  # Build formula
  formula <- as.formula(paste("T_effect ~", species, "+ SR2 + (1|Time) + (1|Origin2:SR2:pot) + (1|res_sp_list)"))
  
  # fit model
  model <- lmer(formula, data = effect_effect_data, 
                #family = gaussian(),  
                control = lmerControl(optimizer = "bobyqa"))
  
  contrast_formula <- as.formula(paste("pairwise ~", species))
  
  species_emmeans = emmeans(model, specs = contrast_formula, type = "response")
  print(species_emmeans$contrasts)
  Anova_data = as.data.frame(car::Anova(model))
  
  species_group = as.tibble(species_emmeans$emmeans)
  species_group$species = species
  species_group$Chisq = Anova_data$Chisq[1]
  species_group$Df = Anova_data$Df[1]
  species_group$chisq_p = Anova_data$`Pr(>Chisq)`[1]
  colnames(species_group)[1] <- "Group"

  sqrtmass_sp_eff_dat <- rbind(sqrtmass_sp_eff_dat, species_group)
}

