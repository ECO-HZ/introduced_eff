# input data without missing values
effect_effect_data = NULL

for (i in 1:nrow(pot_mass_ck_removed)) {
  # Retrieve the information for each column (year, richness, community type)
  sel_pot = pot_mass_ck_removed[i, ]
  
  # Retrieve the data for the corresponding control treatment
  sel_ck_data = subset(pot_mass_all_data_ck, Time == sel_pot$Time & Res_comm == sel_pot$Res_comm)
  
  # Calculate the effect size
  sel_pot$X2_effect = sel_pot$SQRTX2mass 
  sel_pot$R_effect = mean(log(sel_pot$SQRTRmass / sel_ck_data$SQRTRmass), na.rm = TRUE)
  sel_pot$T_effect = mean(log(sel_pot$sqrtmass / sel_ck_data$sqrtmass), na.rm = TRUE)
  sel_pot$CWM_F_Disease_effect = mean(log(sel_pot$CWM_F_Disease / sel_ck_data$CWM_F_Disease), na.rm = TRUE)
  sel_pot$CWM_F_Pest_effect = mean(log(sel_pot$CWM_F_Pest / sel_ck_data$CWM_F_Pest), na.rm = TRUE)
  sel_pot$E_BG_effect = mean(log(sel_pot$E_BG / sel_ck_data$E_BG), na.rm = TRUE)
  sel_pot$E_NAG_effect = mean(log(sel_pot$E_NAG / sel_ck_data$E_NAG), na.rm = TRUE)
  sel_pot$E_AP_effect = mean(log(sel_pot$E_AP / sel_ck_data$E_AP), na.rm = TRUE)
  sel_pot$soilN_effect = mean(log(sel_pot$soilN / sel_ck_data$soilN), na.rm = TRUE)
  
  effect_effect_data = rbind(effect_effect_data, sel_pot)
}


