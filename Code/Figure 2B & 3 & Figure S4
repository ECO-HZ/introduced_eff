  sel_ck_data = subset(pot_mass_ck_data, Time == sel_Time & Res_comm == sel_Pcom)

  sel_pot$Linsitu_effect = mean(log(sel_pot$Mloss / sel_ck_data$Mloss), na.rm = TRUE)
  
  effect_Linsitu_data = rbind(effect_Linsitu_data, sel_pot)
}

