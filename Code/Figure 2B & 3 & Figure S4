  cat("Currently analyzing species:", species, "\n") 
  
  formula <- as.formula(paste("X2_effect ~", species, "+ SR2 + (1|Time) + (1|Origin2:SR2:pot) + 
                         (1|res_sp_list)"))
  
  model <- lmer(formula, data = effect_effect_data, 
                #family = gaussian(),  
