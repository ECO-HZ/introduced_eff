pot_mass_all_data$res_sp_list = as.factor(pot_mass_all_data$res_sp_list)

pot_mass_all_data$Origin_num = ifelse(pot_mass_all_data$Origin2 == "Alien", 1, 0)

# add +1 for CWM_F_Disease CWM_F_Pest
pot_mass_all_data$CWM_F_Disease = sqrt(pot_mass_all_data$CWM_F_Disease+1)
pot_mass_all_data$CWM_F_Pest = sqrt(pot_mass_all_data$CWM_F_Pest+1)

# removed ck
pot_mass_ck_removed = subset(pot_mass_all_data, Origin2 != "ck")
