pot_mass_all_data$Origin2 = ifelse(pot_mass_all_data$Origin2 == "Exotic", "Alien", pot_mass_all_data$Origin2)
pot_mass_all_data$Origin2 = as.factor(pot_mass_all_data$Origin2)
